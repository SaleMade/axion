{
  "name": "sellwave-web",
  "version": "1.25.10",
  "description": "Navegador multi-sessao de WhatsApp Web da SellWave",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "teste": "node src/teste-funcoes.mjs",
    "teste-painel": "node --check src/teste-painel.js && node --check src/teste-painel-preload.js && node --check src/teste-casca-preload.js && electron src/teste-painel.js",
    "confere-pacote": "node src/confere-pacote.cjs dist-pub/win-unpacked/resources/app.asar",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "teste-midia": "node --check src/teste-midia.js && electron src/teste-midia.js",
    "teste-cep": "node --check src/teste-cep.js && electron src/teste-cep.js",
    "icone": "node --check src/icone.js && electron src/icone.js",
    "teste-janela": "node --check src/teste-janela.js && electron src/teste-janela.js",
    "teste-captura": "node --check src/teste-captura.js && electron src/teste-captura.js",
    "teste-destaque": "node --check src/teste-destaque.js && electron ."
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.sellwave.web",
    "productName": "SellWave Web",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "SellWave Web"
    }
  }
}
