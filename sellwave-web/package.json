{
  "name": "sellwave-web",
  "version": "1.3.2",
  "description": "Navegador multi-sessao de WhatsApp Web da SellWave",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "teste": "node src/teste-funcoes.mjs",
    "teste-painel": "electron src/teste-painel.js",
    "confere-pacote": "node src/confere-pacote.cjs dist-pub/win-unpacked/resources/app.asar",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.sellwave.web",
    "productName": "SellWave Web",
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
